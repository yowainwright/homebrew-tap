# frozen_string_literal: true

# This file was generated by scripts/update-formula. DO NOT EDIT.
class <%= class_name %> < Formula
  desc "<%= desc %>"
  homepage "<%= homepage %>"
  version "<%= version %>"
  license "<%= license %>"

  on_macos do
    on_arm do
      url "<%= assets.fetch("darwin-arm64").fetch("url") %>"
      sha256 "<%= assets.fetch("darwin-arm64").fetch("sha256") %>"
    end

    on_intel do
      url "<%= assets.fetch("darwin-amd64").fetch("url") %>"
      sha256 "<%= assets.fetch("darwin-amd64").fetch("sha256") %>"
    end
  end

  on_linux do
    on_arm do
      url "<%= assets.fetch("linux-arm64").fetch("url") %>"
      sha256 "<%= assets.fetch("linux-arm64").fetch("sha256") %>"
    end

    on_intel do
      url "<%= assets.fetch("linux-amd64").fetch("url") %>"
      sha256 "<%= assets.fetch("linux-amd64").fetch("sha256") %>"
    end
  end

  def install
    bin.install Dir["<%= asset_prefix %>-*"].first => "<%= command %>"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/<%= command %> --version")
  end
end
