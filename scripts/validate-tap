#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require_relative "lib/tap_release"

ROOT = TapRelease::ROOT
STRICT = ARGV.include?("--strict")

@errors = []
@validated_packages = []

def fail_with(message)
  @errors << message
end

def relative(path)
  path.delete_prefix("#{ROOT}/")
end

def package_files
  TapRelease.brew_files
end

def validate_package(path)
  data = TapRelease.read_brew(path)
  missing = TapRelease::REQUIRED_BREW_FIELDS.select { |field| data[field].to_s.empty? }
  fail_with "#{relative(path)} missing fields: #{missing.join(", ")}" unless missing.empty?
  return unless missing.empty?

  valid_identity = validate_package_identity(path, data)
  validate_release_options(data)
  @validated_packages << [relative(path), data] if valid_identity
rescue ArgumentError, KeyError, TypeError => error
  fail_with "#{relative(path)}: #{error.message}"
end

def validate_package_identity(path, data)
  expected_name = File.basename(path, ".json")
  valid_name = data.fetch("name") == expected_name
  fail_with "#{relative(path)} name must be #{expected_name}" unless valid_name
  valid_managed = [true, false].include?(data.fetch("managed"))
  fail_with "#{relative(path)} managed must be true or false" unless valid_managed
  valid_archive = [true, false].include?(data.fetch("archive", false))
  fail_with "#{relative(path)} archive must be true or false" unless valid_archive
  valid_name && valid_managed && valid_archive
end

def validate_release_options(data)
  TapRelease.aliases(data)
  TapRelease.targets(data).each { |target| TapRelease.asset_name(data, data.fetch("version"), target) }
  revision = data.fetch("revision", 0)
  raise ArgumentError, "revision must be a nonnegative integer" unless revision.is_a?(Integer) && revision >= 0

  validate_archive_files(data)
end

def valid_archive_filename?(name)
  name.is_a?(String) && name.match?(/\A[0-9A-Za-z._-]+\z/) && !%w[. ..].include?(name)
end

def validate_archive_files(data)
  files = data.fetch("archive_files", [])
  valid_files = files.is_a?(Array) && files.all? { |name| valid_archive_filename?(name) }
  raise ArgumentError, "archive_files must contain filenames" unless valid_files
end

def validate_ruby_syntax(path)
  output, status = Open3.capture2e("ruby", "-c", path)
  fail_with "#{relative(path)} failed ruby syntax:\n#{output}" unless status.success?
end

def validate_readme_markers
  readme = File.read(File.join(ROOT, "README.md"))
  start_count = readme.scan("<!-- formulas:start -->").count
  end_count = readme.scan("<!-- formulas:end -->").count
  fail_with "README.md must contain one generated formulas block" unless start_count == 1 && end_count == 1
end

def validate_readme_block
  readme = File.read(File.join(ROOT, "README.md"))
  block = TapRelease.readme_block(readme)
  return fail_with("README.md missing formulas markers") unless block

  TapRelease.readme_brews.each { |data| validate_readme_section(block, data) }
end

def validate_readme_section(block, data)
  command = data.fetch("command")
  section = TapRelease.readme_section(block, command)
  return fail_with("README.md missing ### #{command} section") unless section

  validate_readme_heading(section.lines.first, data)
  validate_readme_usage(section, data)
end

def validate_readme_heading(heading, data)
  command = data.fetch("command")
  github = "https://github.com/#{data.fetch("repo")}"
  links_to_project = heading.include?(data.fetch("homepage")) || heading.include?(github)
  fail_with "README.md #{command} section missing linked heading" unless heading.start_with?("### [#{command}](")
  fail_with "README.md #{command} section heading must link to project" unless links_to_project
end

def validate_readme_usage(section, data)
  command = data.fetch("command")
  package = data.fetch("name")
  formula = "Formula/#{package}.rb"
  formula_link = "Install [#{command}](#{formula}) | `#{formula}`"
  install = "brew install yowainwright/tap/#{package}"
  fail_with "README.md #{command} section missing install command" unless section.include?(install)
  fail_with "README.md #{command} section missing #{formula_link}" unless section.include?(formula_link)
  fail_with "README.md #{command} section missing Usage label" unless section.include?("\nUsage\n")
  last_line = section.lines.reject { |line| line.strip.empty? }.last&.chomp
  fail_with "README.md #{command} section missing horizontal rule" unless last_line == "---"
end

def reject_paths(paths, label)
  fail_with "#{label}: #{paths.map { |path| relative(path) }.join(", ")}" unless paths.empty?
end

def validate_checksums(paths, label)
  empty_sha = paths.select { |path| File.read(File.join(ROOT, relative(path))).match?(/sha256\s+""/) }
  reject_paths(empty_sha, label)
end

def validate_strict_release_shape
  reject_paths(Dir[File.join(ROOT, "*.rb")], "root formula files are not allowed")
  reject_paths(Dir[File.join(ROOT, "Casks", "*.rb")], "CLI casks are not allowed")
  validate_checksums(Dir[File.join(ROOT, "Formula", "*.rb")], "empty sha256 values")
end

def git_output(*args)
  output, status = Open3.capture2e("git", *args, chdir: ROOT)
  fail_with "git #{args.join(" ")} failed:\n#{output}" unless status.success?

  output
end

def changed_files
  base_ref = ENV.fetch("GITHUB_BASE_REF", "main")
  base = "origin/#{base_ref}"
  merge_base = git_output("merge-base", base, "HEAD").strip
  return [] if merge_base.empty?

  git_output("diff", "--name-only", "--diff-filter=d", "#{merge_base}...HEAD").lines.map(&:strip)
end

def validate_changed_release_shape
  changed = changed_files
  root_formulae = changed.select { |path| path.match?(%r{\A[^/]+\.rb\z}) }
  reject_paths(root_formulae, "changed root formula files are not allowed")

  casks = changed.select { |path| path.start_with?("Casks/") && path.end_with?(".rb") }
  reject_paths(casks, "changed CLI casks are not allowed")

  formulae = changed.select { |path| path.start_with?("Formula/") && path.end_with?(".rb") }
  validate_checksums(formulae, "changed formulas contain empty sha256 values")
end

fail_with "missing brews/*.json" if package_files.empty?

package_files.each { |path| validate_package(path) }
TapRelease.command_conflicts(@validated_packages).each { |conflict| fail_with conflict }
Dir[File.join(ROOT, "Formula", "*.rb")].sort.each { |path| validate_ruby_syntax(path) }
Dir[File.join(ROOT, "scripts", "*")].sort.each do |path|
  next unless File.file?(path)
  next unless File.read(path, 32).start_with?("#!/usr/bin/env ruby")

  validate_ruby_syntax(path)
end
validate_readme_markers
validate_readme_block
validate_changed_release_shape if ARGV.include?("--changed-strict")
validate_strict_release_shape if STRICT

unless @errors.empty?
  warn @errors.join("\n")
  exit 1
end

puts STRICT ? "tap validation passed in strict mode" : "tap validation passed"
