#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/configure-package [package] [options]

Run without options for guided setup. Each flag skips its matching question.

USAGE
  usage_options
  cat <<'USAGE'

Creates brews/<package>.json with managed and readme set to false.
Requires Ruby, like the existing formula scripts. Does not download assets.
Without a terminal, supply required flags; optional values use their defaults.
USAGE
}

usage_options() {
  cat <<'USAGE'
Options:
  --name <package>       Package name (or use the positional argument)
  --repo <owner/repo>     GitHub repository
  --desc <description>   Short description
  --license <license>    SPDX license identifier
  --version <version>    Release version, without the v prefix
  --command <name>       Installed command (default: package)
  --homepage <url>       Project homepage (default: GitHub repository)
  --asset-prefix <name>  Release asset prefix (default: package)
  --archive             Use .tar.gz assets instead of raw binaries
  --no-archive           Use raw binaries (default)
  -h, --help             Show this help
USAGE
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

set_option() {
  local option="${1:?}" value="${2:?}"
  case "$option" in
  --name) package="$value" ;;
  --repo) repo="$value" ;;
  --desc) desc="$value" ;;
  --license) license="$value" ;;
  --version) version="$value" ;;
  --command) command_name="$value" ;;
  --homepage) homepage="$value" ;;
  --asset-prefix) asset_prefix="$value" ;;
  --archive) set_archive "$value" ;;
  *) fail "unknown option: $option" ;;
  esac
}

set_archive() {
  case "$1" in
  y | Y | yes | Yes | YES | true) archive=true ;;
  n | N | no | No | NO | false) archive=false ;;
  *) fail 'archive choice must be yes or no' ;;
  esac
}

parse_options() {
  while (($#)); do
    option_width=1
    parse_option "$@"
    shift "$option_width"
  done
}

parse_option() {
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  --archive) archive=true ;;
  --no-archive) archive=false ;;
  --*)
    [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || fail "missing value for $1"
    set_option "$1" "$2"
    option_width=2
    ;;
  *)
    [[ -z "$package" && "$1" != -* ]] || fail "unexpected argument: $1"
    package="${1:?}"
    ;;
  esac
}

input_is_noninteractive() {
  [[ ! -t 0 ]]
}

prompt_option() {
  local option="${1:?}" label="${2:?}" current="${3:-}" default="${4:-}" answer=''
  [[ -z "$current" ]] || return 0
  if input_is_noninteractive; then
    [[ -n "$default" ]] || fail "missing required $option; supply its flag when no terminal is available"
    set_option "$option" "$default"
    return
  fi
  while [[ -z "$answer" ]]; do
    printf '%s' "$label" >&2
    [[ -z "$default" ]] || printf ' [%s]' "$default" >&2
    printf ': ' >&2
    IFS= read -r answer || fail 'setup cancelled; no configuration written'
    answer="${answer:-$default}"
    [[ -n "$answer" ]] || printf 'A value is required.\n' >&2
  done
  set_option "$option" "$answer"
}

collect_options() {
  prompt_option --name 'Package name (--name)' "$package"
  prompt_option --repo 'GitHub owner/repo (--repo)' "$repo"
  prompt_option --desc 'Description (--desc)' "$desc"
  prompt_option --license 'SPDX license (--license)' "$license"
  prompt_option --version 'Version without v (--version)' "$version"
  prompt_option --command 'Installed command (--command)' "$command_name" "$package"
  prompt_option --homepage 'Homepage (--homepage)' "$homepage" "https://github.com/$repo"
  prompt_option --asset-prefix 'Asset prefix (--asset-prefix)' "$asset_prefix" "$package"
  prompt_option --archive 'Use .tar.gz archives? (--archive/--no-archive)' "$archive" no
}

validate_options() {
  [[ "$archive" == true || "$archive" == false ]] || fail 'archive choice must be true or false'
  [[ "$package" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]] || fail "package must use lowercase letters, digits, and single hyphens"
  [[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "--repo must be owner/repo"
  [[ -n "$desc" && -n "$license" && -n "$version" ]] || fail "--desc, --license, and --version are required"
  [[ "$version" =~ ^[0-9][A-Za-z0-9.+-]*$ ]] || fail "--version must start with a digit; omit the v prefix"
  [[ "$command_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]] || fail "invalid --command"
  [[ "$asset_prefix" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]] || fail "invalid --asset-prefix"
  [[ "$homepage" =~ ^https?://[^[:space:]]+$ ]] || fail "--homepage must be an HTTP(S) URL"
  local value
  for value in "$desc" "$license" "$homepage"; do
    case "$value" in
    *'"'* | *\\* | *'#{'* | *'#@'* | *'#$'* | *[[:cntrl:]]*)
      fail "description, license, and homepage must be single-line text without Ruby quotes, escapes, or interpolation"
      ;;
    esac
  done
}

write_config() {
  ruby -rjson - "$config_path" "$package" "$command_name" "$repo" "$desc" \
    "$homepage" "$license" "$version" "$asset_prefix" "$archive" <<'RUBY'
path, name, command, repo, desc, homepage, license, version, prefix, archive = ARGV
class_name = name.split("-").map(&:capitalize).join
data = {
  "name" => name, "class_name" => class_name, "command" => command,
  "repo" => repo, "desc" => desc, "homepage" => homepage,
  "license" => license, "version" => version, "asset_prefix" => prefix,
  "managed" => false, "readme" => false
}
data["archive"] = true if archive == "true"
File.open(path, File::WRONLY | File::CREAT | File::EXCL) do |file|
  file.write("#{JSON.pretty_generate(data)}\n")
end
RUBY
}

print_tap_link() {
  cat <<'COMMANDS'
  tap_path="$(brew --repository)/Library/Taps/yowainwright/homebrew-tap"
  mkdir -p "$(dirname "$tap_path")"
  if [ ! -e "$tap_path" ] && [ ! -L "$tap_path" ]; then
    ln -s "$PWD" "$tap_path"
  fi
  if [ ! "$PWD" -ef "$tap_path" ]; then
    printf 'Tap already exists elsewhere: %s\n' "$tap_path" >&2
    exit 1
  fi
COMMANDS
}

print_commands() {
  printf 'Created brews/%s.json (managed: false).\n\n' "$package"
  printf 'After verifying all four release assets and matching --version output,\n'
  printf 'set managed to true in brews/%s.json. Then run from the tap root:\n\n' "$package"
  printf '(\n  set -e\n'
  print_tap_link
  printf '  scripts/new-formula %s\n' "$package"
  printf '  scripts/validate-tap --strict\n'
  printf '  brew style Formula/%s.rb\n' "$package"
  printf '  brew audit --strict yowainwright/tap/%s\n' "$package"
  printf '  brew install yowainwright/tap/%s\n' "$package"
  printf '  brew test yowainwright/tap/%s\n' "$package"
  printf ')\n'
  printf '\nFuture releases: scripts/update-formula %s <version>\n' "$package"
}

main() {
  package='' repo='' desc='' license='' version='' command_name='' homepage='' asset_prefix='' archive=''
  parse_options "$@"
  collect_options
  validate_options
  command -v ruby >/dev/null || fail "Ruby is required by the tap scripts"
  repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
  config_path="$repo_root/brews/$package.json"
  formula_path="$repo_root/Formula/$package.rb"
  [[ -d "$repo_root/brews" ]] || fail "missing brews directory"
  [[ ! -e "$config_path" && ! -L "$config_path" ]] || fail "brews/$package.json already exists"
  [[ ! -e "$formula_path" && ! -L "$formula_path" ]] || fail "Formula/$package.rb already exists; use scripts/update-formula"
  write_config
  print_commands
}

main "$@"
