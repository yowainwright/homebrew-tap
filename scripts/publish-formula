#!/usr/bin/env ruby

require "base64"
require "json"
require "open3"
require "rubygems"
require_relative "lib/tap_release"

class HomebrewRelease
  TAP = "yowainwright/homebrew-tap"
  FAILED_CHECKS = %w[FAILURE ERROR TIMED_OUT CANCELLED ACTION_REQUIRED STARTUP_FAILURE].freeze
  WAIT_SECONDS = 1800
  POLL_SECONDS = 10

  def initialize(package, tag)
    raise "Invalid package name" unless package.match?(/\A[a-z0-9][a-z0-9-]*\z/)

    @package = package
    @inventory = "brews/#{package}.json"
    @formula = "Formula/#{package}.rb"
    @data = TapRelease.read_brew(TapRelease.brew_path(package))
    raise "Package is not managed" unless @data.fetch("managed", false)

    @upstream = @data.fetch("repo")
    raise "Caller does not own this package" unless ENV.fetch("SOURCE_REPOSITORY", @upstream) == @upstream

    @version = version_from_tag(tag)
    raise "Tag does not match package metadata" unless tag == release_tag(@version)
  end

  def release_tag(target)
    @data.fetch("tag_template", "v%{version}") % { version: target.to_s }
  end

  def version_from_tag(tag)
    placeholder = "%{version}"
    pattern = Regexp.escape(release_tag(placeholder)).gsub(Regexp.escape(placeholder), "(.+)")
    match = /\A#{pattern}\z/.match(tag)
    raise "Tag does not match package metadata" unless match && match[1]

    version(match[1])
  end

  def version(value)
    stable = value.match?(/\A(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)\z/)
    raise "Expected a stable MAJOR.MINOR.PATCH version: #{value}" unless stable

    Gem::Version.new(value)
  end

  def run(*command)
    output, status = Open3.capture2(*command)
    raise "Command failed: #{command.first(3).join(' ')}" unless status.success?

    output
  end

  def api(path, *arguments)
    JSON.parse(run("gh", "api", "--method", "GET", path, *arguments))
  end

  def tap_file(path, ref)
    response = api("repos/#{TAP}/contents/#{path}", "-f", "ref=#{ref}")
    Base64.decode64(response.fetch("content"))
  end

  def tap_version(ref)
    version(JSON.parse(tap_file(@inventory, ref)).fetch("version"))
  end

  def pending_version
    pulls = api("repos/#{TAP}/pulls", "-f", "state=open", "-f", "base=main",
                "-f", "head=yowainwright:#{@package}")
    return @version if pulls.empty?

    tap_version(pulls.first.fetch("head").fetch("sha"))
  end

  def verify_release(target)
    release = api("repos/#{@upstream}/releases/tags/#{release_tag(target)}")
    unpublished = release.fetch("draft") || release.fetch("prerelease")
    raise "Release v#{target} is not a published stable release" if unpublished

    assets = release.fetch("assets").select { |asset| asset.fetch("size").positive? }
    names = assets.map { |asset| asset.fetch("name") }
    expected = TapRelease.targets(@data).map { |platform| TapRelease.asset_name(@data, target.to_s, platform) }
    raise "Release v#{target} is missing archives" unless (expected - names).empty?
  end

  def output(values)
    File.open(ENV.fetch("GITHUB_OUTPUT"), "a") do |file|
      values.each { |key, value| file.puts "#{key}=#{value}" }
    end
  end

  def prepare
    current = tap_version("main")
    if current >= @version
      output("update" => false, "tag" => release_tag(current), "upstream" => @upstream)
      return
    end

    target = [@version, pending_version].max
    verify_release(target)
    run(File.join(TapRelease::ROOT, "scripts/update-formula"), @package, target.to_s)
    run(File.join(TapRelease::ROOT, "scripts/validate-tap"), "--strict")
    output("update" => true, "tag" => release_tag(target), "upstream" => @upstream)
  end

  def pull_request(number)
    fields = "state,headRefOid,mergeStateStatus,statusCheckRollup"
    JSON.parse(run("gh", "pr", "view", number, "--repo", TAP, "--json", fields))
  end

  def failed_checks?(pull)
    Array(pull["statusCheckRollup"]).any? do |check|
      result = check["conclusion"] || check["state"]
      FAILED_CHECKS.include?(result.to_s.upcase)
    end
  end

  def advance_pull(number, pull)
    raise "Tap PR ##{number} was closed without merging" if pull.fetch("state") == "CLOSED"
    raise "Tap PR ##{number} has merge conflicts" if pull.fetch("mergeStateStatus") == "DIRTY"

    head = pull.fetch("headRefOid")
    if pull.fetch("mergeStateStatus") == "BEHIND"
      run("gh", "pr", "update-branch", number, "--repo", TAP, "--expected-head-oid", head)
      return
    end
    raise "Tap PR ##{number} failed validation" if failed_checks?(pull)
    return if pull.fetch("mergeStateStatus") == "UNKNOWN"
    return if @merge_requested == head

    run("gh", "pr", "merge", number, "--repo", TAP, "--auto", "--squash", "--match-head-commit", head)
    @merge_requested = head
  end

  def wait_for_merge(number)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + WAIT_SECONDS
    loop do
      pull = pull_request(number)
      return if pull.fetch("state") == "MERGED"
      raise "Timed out waiting for tap PR ##{number}" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

      advance_pull(number, pull)
      sleep POLL_SECONDS
    end
  end

  def verify_tap
    head = api("repos/#{TAP}/git/ref/heads/main").fetch("object").fetch("sha")
    current = tap_version(head)
    raise "Tap is still on #{current}; expected at least #{@version}" if current < @version

    formula = tap_file(@formula, head)
    TapRelease.targets(@data).each do |platform|
      asset = TapRelease.asset_name(@data, current.to_s, platform)
      url = "https://github.com/#{@upstream}/releases/download/#{release_tag(current)}/#{asset}"
      raise "Tap formula does not match inventory #{current}" unless formula.include?("url \"#{url}\"")
    end
    puts "Homebrew published #{@package} #{current} (requested #{@version})"
  end

  def finish(number)
    wait_for_merge(number) unless number.to_s.empty?
    verify_tap
  end
end

if $PROGRAM_NAME == __FILE__
  operation, package, tag, number = ARGV
  valid = %w[prepare finish].include?(operation) && package && tag
  abort "usage: publish-formula prepare|finish PACKAGE TAG [PR]" unless valid

  release = HomebrewRelease.new(package, tag)
  if operation == "prepare"
    release.prepare
  else
    release.finish(number)
  end
end
